# Tokens of the zlib (RFC 1950), gzip (RFC 1952) and deflate (RFC 1951) formats

# zlib headers (CMF, FLG)
"\x78\x01"
"\x78\x5e"
"\x78\x9c"
"\x78\xda"
"\x08\x1d"
# zlib header with FDICT and the adler32 of JdkZlibFuzzConfig.DICTIONARY
"\x78\xbb\x7e\x91\x10\xaa"
"\x78\xbb"
"\x7e\x91\x10\xaa"

# gzip header: magic, CM, FLG, MTIME, XFL, OS
"\x1f\x8b"
"\x1f\x8b\x08"
"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff"
"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x03"
# FLG with FHCRC, FEXTRA, FNAME, FCOMMENT
"\x02"
"\x04"
"\x08"
"\x10"
"\x1e"
# FEXTRA XLEN and subfield
"\x04\x00AP\x00\x00"
# gzip trailer of an empty member (CRC32, ISIZE)
"\x00\x00\x00\x00\x00\x00\x00\x00"
# empty gzip member
"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00"

# deflate blocks
# final empty block with fixed Huffman codes
"\x03\x00"
# stored blocks (BFINAL, LEN, NLEN)
"\x01\x00\x00\xff\xff"
"\x00\x00\x00\xff\xff"
"\x01\x05\x00\xfa\xff"
# empty zlib stream
"\x78\x9c\x03\x00\x00\x00\x00\x01"
